# Template for running services outside docker compose. Copy to .env.
# In AWS these come from the ECS task definition; secrets from Secrets Manager.

ENVIRONMENT=local
DATABASE_URL=postgresql://horizon:horizon@localhost:5432/horizon
REDIS_URL=redis://localhost:6379/0

# dev | cognito
AUTH_MODE=dev
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

INTERNAL_TOKEN=local-internal-token-change-me

# redis | aws
EVENT_BACKEND=redis
SNS_TOPIC_ARN=
SQS_QUEUE_URL=

# local | s3
STORAGE_BACKEND=local
S3_BUCKET=
LOCAL_STORAGE_DIR=./.data/documents

# log | ses
EMAIL_BACKEND=log
SES_FROM_ADDRESS=bookings@horizontravel.example

# mock | stripe
PAYMENT_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SEARCH_SERVICE_URL=http://localhost:8001
BOOKING_SERVICE_URL=http://localhost:8002
CUSTOMER_SERVICE_URL=http://localhost:8003
DOCUMENT_SERVICE_URL=http://localhost:8004
