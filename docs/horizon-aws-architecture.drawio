yX=0;entryY=0.5;endArrow=none;" edge="1" parent="1" source="cf" target="waf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F5FAE;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="395" y="150" width="24" height="24" as="geometry"/></mxCell><mxCell id="b2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F5FAE;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="445" width="24" height="24" as="geometry"/></mxCell><mxCell id="b3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F5FAE;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="640" width="24" height="24" as="geometry"/></mxCell><mxCell id="b4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F5FAE;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="405" y="1022" width="24" height="24" as="geometry"/></mxCell><mxCell id="b5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F5FAE;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="1022" width="24" height="24" as="geometry"/></mxCell><mxCell id="b6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F5FAE;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1590" y="412" width="24" height="24" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Rubric mapping&lt;/b&gt;&lt;br&gt;&lt;b&gt;Virtual machines:&lt;/b&gt; EC2 t3.small instances in an Auto Scaling group (2 baseline, 4 at peak)&lt;br&gt;&lt;b&gt;Containers:&lt;/b&gt; four Docker services run by Amazon ECS, images stored in Amazon ECR&lt;br&gt;&lt;b&gt;Virtual networking:&lt;/b&gt; VPC, public and private subnets in two zones, internet gateway, NAT gateway, load balancer, S3 endpoint&lt;br&gt;&lt;b&gt;Virtual storage:&lt;/b&gt; EBS volumes, S3 buckets, RDS storage, ElastiCache memory, AWS Backup vault&lt;br&gt;&lt;b&gt;Security groups:&lt;/b&gt; sg-alb (443 from CloudFront) → sg-app (container ports from sg-alb) → sg-db 5432 and sg-cache 6379 (from sg-app)&lt;br&gt;&lt;b&gt;Request flow:&lt;/b&gt; 1 edge and TLS, 2 internet gateway to load balancer, 3 routed to containers, 4 cache lookup, 5 booking transaction, 6 booking event to SNS and SQS, email through SES" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fillColor=#F7F8FA;strokeColor=#D9DDE5;spacing=10;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="1265" width="1660" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>